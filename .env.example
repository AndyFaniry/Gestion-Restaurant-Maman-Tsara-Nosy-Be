# Copier vers .env et adapter avant le déploiement serveur
# cp .env.example .env

# PostgreSQL (conteneur Docker)
POSTGRES_USER=dev1
POSTGRES_PASSWORD=changez-moi-db

# JDBC Spring — une seule URL (user + password inclus)
# Docker Compose reconstruit l'URL vers l'hôte `db` automatiquement.
DATABASE_URL=jdbc:postgresql://localhost:5432/restaurant?user=dev1&password=changez-moi-db

# DSN MCP Cursor / DBHub (à reporter dans .cursor/mcp.json)
# DSN=postgres://dev1:changez-moi-db@127.0.0.1:5432/restaurant?sslmode=disable

# Compte admin applicatif (mémoire, pas en base)
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=changez-moi-admin

# Optionnel
# SPRING_PROFILES_ACTIVE=prod
# SPRING_JPA_HIBERNATE_DDL_AUTO=update
