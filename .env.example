# === LOCAL (Docker Compose + Postgres conteneur) ===
# cp .env.example .env
# Ne pas pointer vers Neon ici (risque de polluer la prod).

# PostgreSQL conteneur
POSTGRES_USER=dev1
POSTGRES_PASSWORD=changez-moi-db

# Profil Spring local
SPRING_PROFILES_ACTIVE=dev

# JDBC Spring — format jdbc: (user/password dans l'URL)
# Compose reconstruit l'URL vers l'hôte `db` automatiquement pour le service app.
DATABASE_URL=jdbc:postgresql://localhost:5432/restaurant?user=dev1&password=changez-moi-db

# DSN MCP Cursor / DBHub (optionnel, .cursor/mcp.json)
# DSN=postgres://dev1:changez-moi-db@127.0.0.1:5432/restaurant?sslmode=disable

# Compte admin applicatif (mémoire, pas en base)
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=changez-moi-admin
